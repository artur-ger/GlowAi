APP_NAME=GlowAi
APP_ENV=dev
# В prod: явные origin'ы, не *
CORS_ORIGINS=*

# openai_compatible | rule_based
LLM_PROVIDER=rule_based
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_ALLOW_RULE_BASED_FALLBACK=true

# Open-Meteo (по умолчанию без ключа). Опционально Google Geocoding:
GOOGLE_MAPS_API_KEY=

# Auth + SQLite (в Docker: sqlite:////data/glowai.db)
DATABASE_URL=sqlite:////data/glowai.db
JWT_SECRET=dev-change-me-glowai-jwt
JWT_EXPIRE_HOURS=336
CHAT_MAX_MESSAGES_PER_DAY=40

# SMTP (optional). Without SMTP in APP_ENV=dev API returns dev_verify_code.
# In APP_ENV=prod codes are never exposed in JSON — configure SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# В APP_ENV=prod SMTP обязателен (если REQUIRE_SMTP_IN_PROD=true)
REQUIRE_SMTP_IN_PROD=true
REMIND_WORKER_ENABLED=true
REMIND_POLL_SECONDS=60
