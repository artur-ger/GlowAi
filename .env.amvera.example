# Скопируйте в переменные Amvera (раздел «Переменные» / «Секреты»)
# или загрузите как .env, если платформа принимает файл целиком.
# После деплоя замените CORS_ORIGINS на ваш реальный URL Amvera.

APP_NAME=GlowAi
APP_ENV=prod

# После первого деплоя Amvera покажет URL вида https://glowai-xxxx.amvera.ru
# Укажите ЕГО (без слэша в конце). Не оставляйте * в prod.
CORS_ORIGINS=https://ЗАМЕНИТЕ-НА-ВАШ-ПРОЕКТ.amvera.ru

# Сгенерируйте свой: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ЗАМЕНИТЕ_НА_ДЛИННЫЙ_СЛУЧАЙНЫЙ_СЕКРЕТ_МИНИМУМ_24_СИМВОЛА
JWT_EXPIRE_HOURS=336

DATABASE_URL=sqlite:////data/glowai.db

# --- SMTP обязателен в prod (verify email / reset / remind) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=your-mailbox@yandex.ru
SMTP_PASSWORD=your-app-password
SMTP_FROM=GlowAi <your-mailbox@yandex.ru>
SMTP_USE_TLS=true
REQUIRE_SMTP_IN_PROD=true

REMIND_WORKER_ENABLED=true
REMIND_POLL_SECONDS=60
CHAT_MAX_MESSAGES_PER_DAY=40

# LLM опционально; rule_based работает без ключа
LLM_PROVIDER=rule_based
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_ALLOW_RULE_BASED_FALLBACK=true

GOOGLE_MAPS_API_KEY=
